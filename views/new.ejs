<%- include('partials/header') %>

<h1>New Post</h1>

<% if (typeof error !== 'undefined') { %>
  <p class="error"><%= error %></p>
<% } %>

<form action="/posts" method="POST" class="post-form">
  <label for="title">Title</label>
  <input type="text" id="title" name="title" value="<%= typeof old !== 'undefined' ? old.title : '' %>" required />

  <label for="author">Author</label>
  <input type="text" id="author" name="author" value="<%= typeof old !== 'undefined' ? old.author : '' %>" placeholder="Anonymous" />

  <label for="content">Content</label>
  <textarea id="content" name="content" rows="10" required><%= typeof old !== 'undefined' ? old.content : '' %></textarea>

  <div class="actions">
    <button type="submit" class="btn">Publish</button>
    <a href="/posts" class="back-link">Cancel</a>
  </div>
</form>

<%- include('partials/footer') %>
