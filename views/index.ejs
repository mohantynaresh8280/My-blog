<%- include('partials/header') %>

<h1>All Posts</h1>

<% if (posts.length === 0) { %>
  <p class="empty">No posts yet. <a href="/posts/new">Write the first one!</a></p>
<% } else { %>
  <div class="post-list">
    <% posts.forEach(post => { %>
      <article class="post-card">
        <h2><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
        <p class="meta">
          By <%= post.author %> &middot;
          <%= new Date(post.createdAt).toLocaleDateString() %>
        </p>
        <p class="excerpt"><%= post.content.slice(0, 140) %><%= post.content.length > 140 ? '…' : '' %></p>
        <div class="actions">
          <a href="/posts/<%= post.id %>">Read more</a>
          <a href="/posts/<%= post.id %>/edit">Edit</a>
          <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this post?');">
            <button type="submit" class="link-btn danger">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
